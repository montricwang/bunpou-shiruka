tmp/

# 常见构建与依赖缓存（不代表已经选定技术栈）
node_modules/
.venv/
__pycache__/
.pytest_cache/
dist/
build/

# 原始资料及派生数据仅存本地；保留空目录占位符
/data/**
!/data/raw/
!/data/processed/
!/data/raw/.gitkeep
!/data/processed/.gitkeep
